# Environment configuration for SecureLex IDE (apsla)

# ── Server & Application Settings ─────────────────────────────────────
APSLA_ENV=development
APSLA_HOST=127.0.0.1
APSLA_PORT=8000
APSLA_DEBUG=false
APSLA_MODEL_PATH=src/apsla/ml/artifacts/best_model.joblib

# ── Agentic Compiler & Local LLM (Phase 15) ───────────────────────────
# Agent Mode: 'off' (deterministic pipeline), 'rules' (RulesPlanner, 0 LLM calls), or 'local' (Ollama)
APSLA_AGENT_MODE=off

# Local LLM service URL (strictly loopback 127.0.0.1 / localhost)
APSLA_LOCAL_URL=http://127.0.0.1:11434

# Local LLM model identifier
APSLA_LOCAL_MODEL=qwen2.5-coder:3b

# Execution budget and safety constraints
APSLA_AGENT_MAX_STEPS=12
APSLA_AGENT_MAX_LLM_CALLS=8
APSLA_AGENT_TIMEOUT_S=60.0
