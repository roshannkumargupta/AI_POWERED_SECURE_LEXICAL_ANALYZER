# Environment configuration for SecureLex IDE (apsla)

# ── Server & Application Settings ─────────────────────────────────────
APSLA_ENV=development
APSLA_HOST=127.0.0.1
APSLA_PORT=8000
APSLA_DEBUG=false
APSLA_MODEL_PATH=src/apsla/ml/artifacts/best_model.joblib

# ── Agentic Compiler & Local LLM (Phase 15) ───────────────────────────
# Agent Mode: 'off' (deterministic pipeline), 'rules' (RulesPlanner, 0 LLM calls), or 'local' (Ollama)
APSLA_AGENT_MODE=off

# Local LLM service URL (strictly loopback 127.0.0.1 / localhost)
APSLA_LOCAL_URL=http://127.0.0.1:11434

# Local LLM model identifier
APSLA_LOCAL_MODEL=qwen2.5-coder:3b

# Execution budget and safety constraints
APSLA_AGENT_MAX_STEPS=12
APSLA_AGENT_MAX_LLM_CALLS=8
APSLA_AGENT_TIMEOUT_S=60.0

# ── AI Model Provider Configuration ────────────────────────────────────
# Provider: 'auto' (prefers Groq if key present, else Ollama), 'groq', 'ollama', or 'openai-compatible'.
# Deterministic lexing, parsing, and rule fixes ALWAYS stay 100% local.
SECURELEX_AI_PROVIDER=auto
SECURELEX_AI_TIMEOUT_SECONDS=30

# Groq Hybrid Cloud Provider (Remote - requires explicit UI consent)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL_FAST=llama-3.1-8b-instant
GROQ_MODEL_CODE=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_CONCURRENCY=2

# Ollama Local Provider (strictly loopback)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:3b

# OpenAI-Compatible Provider (Alternative)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_MODEL=
OPENAI_COMPAT_API_KEY=

