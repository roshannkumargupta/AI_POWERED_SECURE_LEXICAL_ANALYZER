# Environment configuration for SecureLex IDE (apsla)

# ── Server & Application Settings ─────────────────────────────────────
APSLA_ENV=development
APSLA_HOST=127.0.0.1
APSLA_PORT=8000
APSLA_DEBUG=false
APSLA_MODEL_PATH=src/apsla/ml/artifacts/best_model.joblib

# ── AI Model Provider Configuration (Groq only) ────────────────────────
# Groq is the only AI provider. Deterministic analysis and rule fixes stay 100% local.
SECURELEX_AI_PROVIDER=groq
SECURELEX_AI_TIMEOUT_SECONDS=30

# Groq Cloud Provider (Remote - requires explicit UI consent)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL_FAST=llama-3.1-8b-instant
GROQ_MODEL_CODE=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_CONCURRENCY=2
