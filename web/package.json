{
  "name": "securelex-ide-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --check src",
    "format:fix": "prettier --write src",
    "e2e": "playwright test -c playwright.config.ts",
    "e2e:f4": "playwright test -c playwright.config.ts e2e/f4-closure.spec.ts",
    "qa": "node ../scripts/qa_full.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.0.21",
    "@fontsource/jetbrains-mono": "^5.0.21",
    "@fontsource/material-symbols-outlined": "^5.3.9",
    "@monaco-editor/react": "^4.6.0",
    "lucide-react": "^0.441.0",
    "monaco-editor": "^0.49.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^2.1.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.5.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^25.0.0",
    "postcss": "^8.5.29",
    "prettier": "^3.9.10",
    "tailwindcss": "3.4",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^2.0.5"
  }
}
